{
  "name": "home-mart",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "db:migrate": "npm run migrate -w apps/api",
    "db:seed": "npm run seed -w apps/api",
    "test:api": "npm run test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "^19.2.8"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "multer": "^2.3.0",
    "js-yaml": "^5.4.1",
    "lodash": "^4.18.1",
    "body-parser": "^2.3.0",
    "qs": "^6.16.0",
    "postcss": "^8.5.26",
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.2"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
