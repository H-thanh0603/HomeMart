# HomeMart — Production environment template
# cp .env.production.example .env.production rồi điền giá trị thật.
# KHÔNG commit .env.production.

# ─── App ───
NODE_ENV=production
API_PORT=4000
WEB_URL=http://localhost
HTTP_PORT=80
# URL công khai của API (dùng cho IPN/webhook của cổng thanh toán).
# Đổi thành https://your-domain.com khi có domain + HTTPS.
API_PUBLIC_URL=http://localhost

# URL API mà TRÌNH DUYỆT sẽ gọi. Mặc định /api/v1 (đi qua nginx cùng origin).
# Nếu host API riêng khác domain web, đặt full URL: https://api.your-domain.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# ─── Database (container nội bộ) ───
# Connection pool được set trong docker-compose.prod.yml (connection_limit=20,
# pool_timeout=10) — chỉnh tại đó khi tăng số replica API.
POSTGRES_USER=homemart
POSTGRES_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__
POSTGRES_DB=homemart

# ─── JWT (BẮT BUỘC ĐỔI — min 32 ký tự random) ───
# openssl rand -base64 48
JWT_ACCESS_SECRET=__CHANGE_ME_RANDOM_32_CHARS_MINIMUM__
JWT_REFRESH_SECRET=__CHANGE_ME_RANDOM_32_CHARS_MINIMUM__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ─── Business ───
TAX_RATE=0.08
ORDER_PAYMENT_TIMEOUT_MINUTES=30

# ─── Payment providers (điền credential production thật) ───
# CẢNH BÁO: đang là URL sandbox. Khi có merchant thật, thay bằng:
#   VNPAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
#   VNPAY_API_URL=https://vnpayment.vn/merchant_webapi/api/transaction
#   MOMO_API_URL=https://payment.momo.vn/v2/gateway/api/create
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost/payments/vnpay/return
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost/payments/momo/return
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hướng dẫn chuyển khoản hiển thị cho khách (phương thức BANK_TRANSFER)
BANK_ACCOUNT_INFO=

# ─── Mail (SMTP thật: SendGrid/Mailgun/SES...) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@your-domain.com

# ─── Storage ───
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=5
