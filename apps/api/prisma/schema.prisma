// HomeMart — PostgreSQL schema (Prisma)
// Money: VND stored as BigInt-safe Int (VND has no minor units in practice)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InventoryTransactionType {
  INITIAL
  RESERVE
  RELEASE
  COMMIT_SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentMethodType {
  COD
  VNPAY
  MOMO
  STRIPE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum ShippingMethodCode {
  STANDARD
  EXPRESS
  SAME_DAY
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum ShipmentStatus {
  PREPARING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ALL
  PRODUCT
  CATEGORY
  BRAND
}

enum VoucherStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum NotificationType {
  ORDER_CREATED
  PAYMENT_SUCCESS
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  REFUND_SUCCESS
  LOW_STOCK_ALERT
  PROMOTION
  SYSTEM
}

// ─────────────────────── IDENTITY & ACCESS ───────────────────────

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  emailVerifiedAt   DateTime?
  passwordHash      String
  fullName          String
  phone             String?
  avatarUrl         String?
  role              Role       @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  addresses       Address[]
  carts           Cart[]
  wishlist        Wishlist?
  orders          Order[]
  reviews         Review[]
  voucherUsages   VoucherUsage[]
  notifications   Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String? // rotation chain

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  purpose   TokenPurpose @default(PASSWORD_RESET)
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  province   String
  district   String
  ward       String
  line       String
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────── CATALOG ───────────────────────────

model Category {
  id          String         @id @default(uuid())
  parentId    String?
  name        String
  slug        String         @unique
  description String?
  imageUrl    String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  seoTitle       String?
  seoDescription String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  logoUrl   String?
  description String?

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("brands")
}

model Product {
  id               String        @id @default(uuid())
  sku              String        @unique
  slug             String        @unique
  name             String
  shortDescription String?
  description      String?

  categoryId String
  brandId    String?

  price           Int // current selling price (VND)
  compareAtPrice  Int? // original/list price for discount display
  costPrice       Int?

  status    ProductStatus @default(DRAFT)
  weightGrams Int?
  widthCm   Decimal? @db.Decimal(6, 2)
  heightCm  Decimal? @db.Decimal(6, 2)
  lengthCm  Decimal? @db.Decimal(6, 2)

  warrantyMonths Int?
  origin         String?

  tags String[] @default([])

  ratingAvg  Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int    @default(0)
  soldCount  Int     @default(0)

  seoTitle       String?
  seoDescription String?

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])

  variants     ProductVariant[]
  images       ProductImage[]
  attributes   ProductAttribute[]
  inventories  Inventory[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  relatedProductIds String[] @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId, status])
  @@index([brandId])
  @@index([status, createdAt(sort: Desc)])
  @@index([price])
  @@index([name])
  @@index([soldCount(sort: Desc)])
  @@map("products")
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  sku        String  @unique
  attributes Json // {"Màu": "Đen", "Dung tích": "1.8L"}
  price      Int
  compareAtPrice Int?
  imageUrl   String?
  status     ProductStatus @default(PUBLISHED)

  product   Product   @relation(fields: [productId], references: [id])
  inventory Inventory?
  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  variantId String?
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String
  name      String // "Công suất"
  value     String // "800W"
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

// ─────────────────────────── INVENTORY ───────────────────────────

model Inventory {
  id            String @id @default(uuid())
  productId     String
  variantId     String? @unique
  availableStock Int   @default(0)
  reservedStock  Int   @default(0)
  soldStock      Int   @default(0)
  lowStockThreshold Int @default(5)

  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  transactions InventoryTransaction[]

  updatedAt DateTime @updatedAt

  @@unique([productId, variantId])
  @@index([availableStock])
  @@map("inventories")
}

model InventoryTransaction {
  id          String                   @id @default(uuid())
  inventoryId String
  type        InventoryTransactionType
  quantity    Int // signed delta
  reference   String? // orderId / note
  actorId     String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([inventoryId, createdAt])
  @@map("inventory_transactions")
}

// ─────────────────────────── CART & WISHLIST ───────────────────────────

model Cart {
  id        String     @id @default(uuid())
  userId    String?    // null = guest cart (identified by guestToken)
  guestToken String?   @unique
  status    CartStatus @default(ACTIVE)

  items CartItem[]

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int

  savedForLater Boolean @default(false)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Wishlist {
  id     String  @id @default(uuid())
  userId String  @unique

  items WishlistItem[]

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  @@map("wishlists")
}

model WishlistItem {
  id         String @id @default(uuid())
  wishlistId String
  productId  String
  variantId  String?

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([wishlistId, productId, variantId])
  @@map("wishlist_items")
}

// ─────────────────────────── ORDERS ───────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // HM-20260825-000123
  userId      String

  status OrderStatus @default(PENDING)

  contactName  String
  contactPhone String

  shippingProvince String
  shippingDistrict String
  shippingWard     String
  shippingLine     String

  subtotalAmount   Int
  discountAmount   Int @default(0)
  shippingFee      Int @default(0)
  taxAmount        Int @default(0)
  totalAmount      Int

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  shipment         Shipment?
  voucherCode      String?

  note          String?
  adminNote     String?
  cancelledReason String?
  completedAt   DateTime?
  confirmedAt   DateTime?

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]


  user User @relation(fields: [userId], references: [id])

  version Int @default(1) // optimistic lock

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

// Immutable snapshot at purchase time
model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  productId String
  variantId String?

  productName    String // snapshot
  productImage   String? // snapshot
  sku            String // snapshot
  variantAttributes Json? // snapshot
  unitPrice      Int // snapshot
  quantity       Int
  lineTotal      Int

  reviewed Review?

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id       String      @id @default(uuid())
  orderId  String
  fromStatus OrderStatus?
  toStatus OrderStatus
  note     String?
  actorId  String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ─────────────────────────── PAYMENTS ───────────────────────────

model Payment {
  id     String @id @default(uuid())
  orderId String @unique
  method PaymentMethodType
  status PaymentStatus @default(PENDING)
  amount Int

  providerRef String? @unique // provider txn id / vnp_TxnRef
  paidAt      DateTime?
  failedReason String?

  transactions PaymentTransaction[]

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

// Raw webhook/callback log — dedupe key for idempotency
model PaymentTransaction {
  id         String @id @default(uuid())
  paymentId  String
  providerTxnId String
  eventType  String
  payload    Json
  signatureValid Boolean @default(false)

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([providerTxnId, eventType]) // idempotency: duplicate callbacks ignored
  @@index([paymentId])
  @@map("payment_transactions")
}

// ─────────────────────────── SHIPPING ───────────────────────────

model ShippingMethod {
  id   String @id @default(uuid())
  code ShippingMethodCode @unique
  name String
  baseFee Int
  feePerKg Int
  freeShippingMinSubtotal Int? // e.g. 500000 → free standard
  estimatedDaysMin Int
  estimatedDaysMax Int
  isActive Boolean @default(true)

  shipments Shipment[]
  orders Order[]

  @@map("shipping_methods")
}

model Shipment {
  id       String @id @default(uuid())
  orderId  String @unique
  methodId String
  carrierName  String?
  trackingCode String?
  status   ShipmentStatus @default(PREPARING)
  shippedAt DateTime?
  deliveredAt DateTime?
  logs Json? // tracking history array

  order  Order         @relation(fields: [orderId], references: [id])
  method ShippingMethod @relation(fields: [methodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipments")
}

// ─────────────────────────── PROMOTIONS ───────────────────────────

model Promotion {
  id   String @id @default(uuid())
  name String
  type PromotionType
  scope DiscountScope @default(ALL)
  scopeId String? // productId/categoryId/brandId when scoped

  value Int // percent 1-100 or fixed amount VND
  maxDiscountAmount Int?

  startsAt DateTime
  endsAt   DateTime
  isActive Boolean @default(true)

  vouchers Voucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

model Voucher {
  id   String @id @default(uuid())
  code String @unique
  promotionId String?

  type PromotionType
  value Int
  maxDiscountAmount Int?
  minOrderAmount Int @default(0)

  usageLimit Int? // null = unlimited
  usedCount  Int @default(0)
  usageLimitPerUser Int @default(1)

  startsAt DateTime
  endsAt   DateTime
  status   VoucherStatus @default(ACTIVE)

  promotion Promotion? @relation(fields: [promotionId], references: [id])
  usages    VoucherUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status, endsAt])
  @@map("vouchers")
}

model VoucherUsage {
  id        String @id @default(uuid())
  voucherId String
  userId    String
  orderId   String @unique

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([voucherId, userId, orderId])
  @@index([voucherId, userId])
  @@map("voucher_usages")
}

// ─────────────────────────── REVIEWS ───────────────────────────

model Review {
  id       String @id @default(uuid())
  userId   String
  productId String
  orderItemId String @unique // verified purchase: 1 review per purchased item
  rating   Int // 1-5
  comment  String?
  status   ReviewStatus @default(PENDING)

  images ReviewImage[]

  user       User      @relation(fields: [userId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  orderItem  OrderItem @relation(fields: [orderItemId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId, status])
  @@index([userId])
  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  url      String

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_images")
}

// ─────────────────────────── NOTIFICATIONS & AUDIT ───────────────────────────

model Notification {
  id     String @id @default(uuid())
  userId String
  type   NotificationType
  title  String
  body   String
  data   Json?
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id       String @id @default(uuid())
  actorId  String?
  action   String // "order.status_update", "product.create", ...
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
